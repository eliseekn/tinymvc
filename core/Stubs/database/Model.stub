declare(strict_types=1);

namespace NAMESPACE;

use Core\Database\Model;
use Core\Database\Factory\HasFactory;
use Core\Support\Pagination;

class CLASSNAME extends Model
{
    use HasFactory;

    public function __construct(public array $attributes = [])
    {
        parent::__construct('TABLE_NAME', $attributes);
    }

    public static function query(): Model
    {
        return new self;
    }

    public static function find(int $id): ?Model
    {
        return self::query()->findBy('id', $id);
    }

    public static function findByColumn(string $column): ?Model
    {
        return self::query()->findBy('column', $column);
    }

    public static function findAll(): array
    {
        return self::query()->getAll('*');
    }

    public static function findAllByColumn(string $column): array
    {
        return self::query()
            ->select('*')
            ->where('column', $column)
            ->getAll();
    }

    public static function findAllPaginate(): Pagination
    {
        $perPage = (int) request()->queries('perPage', 10);
        $page = (int) request()->queries('page', 1);

        return self::query()
            ->select('*')
            ->paginate($perPage, $page);
    }
}
