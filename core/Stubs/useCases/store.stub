declare(strict_types=1);

namespace NAMESPACE;

use App\Database\Entities\ENTITY_NAME;

final class CLASSNAME
{
    public function handle(array $data): ?ENTITY_NAME
    {
        $entity = (new ENTITY_NAME);

        if ((bool) $entity->toModel($data)->save()) {
            return $entity;
        }

        return null;
    }
}
