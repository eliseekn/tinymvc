namespace NAMESPACE;

use App\Database\Models\MODEL_NAME;
use Core\Support\UseCase;

class CLASSNAME extends UseCase
{
    public function handle(int $id): bool
	{
        $MODEL_NAME = MODEL_NAME::find($id);
        return $MODEL_NAME && $MODEL_NAME->delete();
	}
}
