declare(strict_types=1);

namespace NAMESPACE;

use App\Database\Entities\ENTITY_NAME;
use Core\Database\Model;
use Core\Http\Resource;

class CLASS_NAME extends Resource
{
    public function toArray(Model $model): array
    {
        $ENTITY = $model->toEntity(ENTITY_NAME::class);

        return [
            'id' => $ENTITY->getId(),
        ];
    }
}
