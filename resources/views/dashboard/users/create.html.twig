{% extends "layouts/dashboard.html.twig" %}

{% block title %}
	Users | Create
{% endblock %}

{% block description %}
	Create new user
{% endblock %}

{% block content %}
<div class="d-flex align-items-center justify-content-between mb-3">
	<h1>Create user</h1>
</div>

<div class="card shadow">
	<form method="post" action="{{ url('/dashboard/users') }}" id="add-form">
		{{ csrf_token_input()|raw }}

		<div class="card-body">
			<div class="modal-body">
				<div class="mb-3">
					<label for="name" class="form-label">{{ __('name') }}</label>
					<input type="text" class="form-control {{ errors.name ? 'is-invalid' }}" value="{{ inputs.name ?: '' }}" aria-describedby="name-error" name="name" id="name" autofocus>

					{% if errors.name is not empty %}
						<div id="name-error" class="invalid-feedback">
							{{ errors.name }}
						</div>
					{% endif %}
				</div>

				<div class="mb-3">
					<label for="email" class="form-label">{{ __('email') }}</label>
					<input type="email" id="email" name="email" class="form-control {{ errors.email ? 'is-invalid' }}" value="{{ inputs.email ?: '' }}" aria-describedby="email-error">

					{% if errors.email is not empty %}
						<div id="email-error" class="invalid-feedback">
							{{ errors.email }}
						</div>
					{% endif %}
				</div>

				<div class="mb-3">
					<label for="role" class="form-label">Role</label>

					<select name="role" id="role" class="form-select {{ errors.role ? 'is-invalid' }}" aria-describedby="role-error">
						<option value="{{ enum("\\App\\Enums\\UserRole").USER.value }}">
							{{ enum("\\App\\Enums\\UserRole").USER.value }}
						</option>
						<option value="{{ enum("\\App\\Enums\\UserRole").ADMIN.value }}">
							{{ enum("\\App\\Enums\\UserRole").ADMIN.value }}
						</option>
					</select>

					{% if errors.role is not empty %}
						<div id="role-error" class="invalid-feedback">
							{{ errors.role }}
						</div>
					{% endif %}
				</div>

				<div>
					<label for="password" class="form-label">{{ __('password') }}</label>

					<div class="input-group">
						<input type="password" id="password" name="password" class="form-control {{ errors.password ? 'is-invalid' }}" value="{{ inputs.password ?: '' }}" aria-describedby="password-error">

						<span class="input-group-text" id="password-toggle" title="Toggle display" style="cursor: pointer">
							<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-eye-fill" viewBox="0 0 16 16">
							  <path d="M10.5 8a2.5 2.5 0 1 1-5 0 2.5 2.5 0 0 1 5 0"/>
							  <path d="M0 8s3-5.5 8-5.5S16 8 16 8s-3 5.5-8 5.5S0 8 0 8m8 3.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7"/>
							</svg>
						</span>
					</div>

					{% if errors.password is not empty %}
						<div id="password-error" class="invalid-feedback d-block">
							{{ errors.password|raw }}
						</div>
					{% endif %}
				</div>
			</div>
		</div>

		<div class="card-footer">
			<button type="submit" class="btn btn-primary spinner me-3">Submit</button>
			<a href="{{ url('dashboard/users') }}" class="btn btn-secondary">Cancel</a>
		</div>
	</form>
</div>
{% endblock %}
