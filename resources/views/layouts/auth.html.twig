{% apply spaceless %}
<!DOCTYPE html>
<html lang="{{ config('app.lang') }}">
    <head>
        <meta charset="utf-8">
        <meta http-equiv="X-UA-Compatible" content="IE=Edge">
        <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
        <meta name="description" content="{% block description %}{% endblock %}">

        {{ csrf_token_meta()|raw }}

        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
        <link rel="stylesheet" href="{{ public_url('css/style.css') }}">

        <title>{% block title %}{% endblock %}</title>
    </head>

    <body>
        <div class="container py-5" style="width: 430px">
            <h1 class="pb-3 text-center">{{ block("title") }}</h1>

            {% if alert is not empty %}
                {% include "partials/alert.html.twig" with {alert: alert} %}
            {% endif %}

            {% block content %}{% endblock %}

            <div class="mt-4 text-center">
                <a href="{{ url('/') }}">{{ __('app.back_home') }}</a>
            </div>
        </div>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
        <script type="module"  src="{{ public_url('js/index.js') }}"></script>
    </body>
</html>
{% endapply %}