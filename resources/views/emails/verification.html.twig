{% extends "layouts/email.html.twig" %}

{% block content %}
    <p>{{ __('email.email_verification', {'app_name': config('app.name')}) }}</p>
    <p><a href="{{ url('email/verify?email=' ~ email ~ '&token=' ~ token) }}">{{ url('email/verify?email=' ~ email ~ '&token=' ~ token) }}</a></p>
    <hr>
    <p>{{ __('email.ignore_mail') }}</p>
{% endblock %}
