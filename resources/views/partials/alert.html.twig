{% if alert.display == 'toast' %}
    <div class="position-absolute" style="top: 1em; right: 1em; z-index: 11111" data-timeout="2000">
        <div class="alert alert-{{ alert.type }} alert-dismissible show" role="alert">
            {{ alert.message|raw }}

            <button class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    </div>
{% else %}
    <div class="alert alert-{{ alert.type }} alert-dismissible show" role="alert">
        {{ alert.message|raw }}

        {% if alert.dismiss %}
        <button class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        {% endif %}
    </div>
{% endif %}
