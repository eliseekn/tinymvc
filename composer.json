{
  "name": "eliseekn/tinymvc",
  "description": "TinyMVC is a PHP framework based on MVC architecture that helps you build easily and quickly powerful web applications and RESTful API.",
  "type": "project",
  "license": "MIT",
  "keywords": [
    "php",
    "framework",
    "mvc"
  ],
  "version": "1.0",
  "authors": [
    {
      "name": "N'Guessan Kouadio Elisée",
      "email": "eliseekn@gmail.com",
      "homepage": "https://eliseekn.netlify.app",
      "role": "Developer"
    }
  ],
  "minimum-stability": "dev",
  "autoload": {
    "files": [
      "app/Helpers.php",
      "core/Support/Helpers.php"
    ],
    "psr-4": {
      "App\\": "app/",
      "Core\\": "core/",
      "Tests\\": "tests/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "allow-plugins": {
      "cweagans/composer-patches": true
    }
  },
  "require": {
    "php": "^8.4",
    "phpmailer/phpmailer": "^6.9",
    "nesbot/carbon": "^3.0",
    "twig/twig": "^3.16",
    "symfony/console": "^7.2",
    "dflydev/dot-access-data": "^3.0",
    "symfony/process": "^7.2",
    "spatie/php-structure-discoverer": "^2.0",
    "psy/psysh": "^0.12",
    "symfony/mime": "^7.2",
    "doctrine/dbal": "^4.3",
    "standaniels/image-generator": "^1.1.0",
    "dompdf/dompdf": "^3.0",
    "somnambulist/validation": "^1.12.2",
    "twilio/sdk": "^8.3",
    "predis/predis": "^2.2",
    "symfony/panther": "^2.4",
    "cweagans/composer-patches": "*",
    "symfony/http-client": "8.0.x-dev",
    "goldspecdigital/oooas": "dev-master"
  },
  "extra": {
    "patches": {
      "somnambulist/validation": {
        "Fix null array offset in resolveAttributeName": "patches/somnambulist-validation-fix-null-array-offset.patch"
      },
      "standaniels/image-generator": {
        "Fix PHP 8.5 deprecations: implicit nullable params and imagedestroy": "patches/standaniels-image-generator-fix-deprecations.patch"
      },
      "goldspecdigital/oooas": {
        "Fix PHP 8.4 implicit nullable parameter deprecations": "patches/goldspecdigital-oooas-fix-nullable-deprecations.patch"
      }
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5",
    "symfony/var-dumper": "^7.2",
    "filp/whoops": "^2.16",
    "fakerphp/faker": "^1.24",
    "phpstan/phpstan": "^2.0",
    "friendsofphp/php-cs-fixer": "^3.68",
    "symfony/finder": "^7.2",
    "symfony/test-pack": "^1.1"
  }
}
